{"code":"var mUI = ui.views.housesys.ui_house_onsaleUI;\r\nimport ViewBase from \"../../../../frame/view/ViewBase\";\r\nimport { ui } from \"../../../../ui/layaMaxUI\";\r\nimport { AudioHelper } from \"../../../common/help/AudioHelper\";\r\nimport { E } from \"../../../G\";\r\nimport { ResPath } from \"../../../resouce/ResPath\";\r\nimport { HouseSysData } from \"../data/HouseSysData\";\r\nimport { HouseSysClient } from \"../../../network/clients/HouseSysClient\";\r\nimport StringUtil from \"../../../../frame/util/StringUtil\";\r\nimport { HouseSysEventID } from \"../HouseSysEventID\";\r\nimport { EMsgBoxType } from \"../../../common/defines/EnumDefine\";\r\nimport Callback from \"../../../event/Callback\";\r\nexport class View_HouseOnSale extends ViewBase {\r\n    constructor() {\r\n        super(...arguments);\r\n        this.bSale = false;\r\n    }\r\n    onAddLoadRes() {\r\n        this.addRes(ResPath.View.HouseOnSale, Laya.Loader.JSON);\r\n        this.addRes(ResPath.Atlas.Comp, Laya.Loader.ATLAS);\r\n        this.addRes(ResPath.Atlas.Main_Common, Laya.Loader.ATLAS);\r\n        this.addRes(ResPath.Atlas.Main_HouseSys, Laya.Loader.ATLAS);\r\n    }\r\n    onEnter() {\r\n    }\r\n    onExit() {\r\n    }\r\n    onFirstInit() {\r\n        this.UI = this._ui = new mUI();\r\n    }\r\n    onInit() {\r\n        this.onInitData();\r\n        this.onInitUI();\r\n    }\r\n    onAddEventListener() {\r\n        this.addEventSys(Laya.Event.CLICK, this.onClickClose, this, this._ui.box_close);\r\n        this.addEventSys(Laya.Event.CLICK, this.onClickOnSale, this, this._ui.btn_onsale);\r\n        this.addEventSys(Laya.Event.INPUT, this.onInputPrice, this, this._ui.input_price);\r\n        this.addEventCus(HouseSysEventID.HouseSysOnSaleRsp, this.OnHouseSysOnSaleRsp, this);\r\n        this.addEventCus(HouseSysEventID.HouseSysOffSaleRsp, this.OnHouseSysOffSaleRsp, this);\r\n        this.addEventCus(HouseSysEventID.HouseSysGetSaleListRsp, this.OnHouseSysGetSaleListRsp, this);\r\n  