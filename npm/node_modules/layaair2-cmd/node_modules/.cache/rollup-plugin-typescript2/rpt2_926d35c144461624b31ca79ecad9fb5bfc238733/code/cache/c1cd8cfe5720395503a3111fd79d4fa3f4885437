this._characterCtrl.colliderShape = this._colliderShape;\r\n        this._characterCtrl.collisionGroup = this._colGroup;\r\n        this._characterCtrl.gravity.y = -10;\r\n        this._characterCtrl.jumpSpeed = 9.5;\r\n        this._characterCtrl.fallSpeed = 55;\r\n        this._characterCtrl.maxSlope = 45;\r\n        this._characterCtrl.stepHeight = 0.3;\r\n        this._characterCtrl.restitution = 0;\r\n        this._characterCtrl.friction = 0.1;\r\n        this._characterCtrl.rollingFriction = 1;\r\n    }\r\n    clearCharacter() {\r\n        if (this._characterCtrl != null) {\r\n            this._characterCtrl.destroy();\r\n            this._characterCtrl = null;\r\n        }\r\n        this._colliderShape = null;\r\n    }\r\n    initShadow() {\r\n        if (this.obj_model.getChildByName(\"Shadow\") == null) {\r\n            E.ResMgr.GetSprite3D(ResPath.U3D.shadow, Callback.Create(this, (obj) => {\r\n                if (this.obj_model == null) {\r\n                    obj.destroy();\r\n                    return;\r\n                }\r\n                this.shadow = obj;\r\n                this.obj_model.addChild(this.shadow);\r\n                this.shadow.transform.localPosition = new Laya.Vector3(0, 0.01, 0);\r\n            }));\r\n        }\r\n    }\r\n    clearShadow() {\r\n        this.shadow.removeSelf();\r\n        this.shadow.destroy();\r\n        this.shadow = null;\r\n    }\r\n    initAbilitys() {\r\n        this._abilityCtrl = new AbilityCtrl();\r\n        this.AddAbilities([EAbility.Idle, EAbility.Move, EAbility.Jump, EAbility.Action]);\r\n    }\r\n    clearAbilitys() {\r\n        if (this._abilityCtrl) {\r\n            this._abilityCtrl.Clear();\r\n            this._abilityCtrl = null;\r\n        }\r\n    }\r\n    AddAbilities(types) {\r\n        if (types != null && types.length > 0) {\r\n            types.forEach(t => {\r\n                this.AddAbility(t);\r\n            });\r\n        }\r\n    }\r\n    AddAbility(type) {\r\n        this._abilityCtrl.AddAbility(type);\r\n        this._abilityCtrl.InitAbility(type, this.Obj);\r\n    }\r\n    UseAbility(type) {\r\n        this._abilityCtrl.UseAbility(type);\r\n    }\r\n    DoIdle() {\r\n        let idle = this._abilityCtrl.GetAbility(EAbility.Idle);\r\n        if (idle == null) {\r\n            return;\r\n        }\r\n        idle.DoIdle();\r\n    }\r\n    SetTargetMove(pos, euler) {\r\n        if (this.IsJumping())\r\n            return;\r\n        let move = this._abilityCtrl.GetAbility(EAbility.Move);\r\n        if (move == null) {\r\n            return;\r\n        }\r\n        let mul = 1;\r\n        let speed = this._moveSpeed * mul;\r\n        let dir = Vec3Util.Normalize(euler);\r\n        let velocity = this.getMoveVelocity(speed, dir);\r\n        move.DoMove(velocity, pos, euler, Callback.Create(this, this.DoIdle), Callback.Create(this, () => {\r\n        }));\r\n    }\r\n    getForward() {\r\n        return Vec3Util.GetForward(this.obj_model.transform);\r\n    }\r\n    getMoveVelocity(speed, dir) {\r\n        let velocity = Vec3Util.Scale(new Laya.Vector3(-dir.x * speed, dir.y * speed, -dir.z * speed), TimeUtil.FixedDeltaTimeS);\r\n        return velocity;\r\n    }\r\n    MoveFoward(mul) {\r\n        this.interruptAutoMove();\r\n        this.moveForward(mul);\r\n    }\r\n    moveForward(mul) {\r\n        if (this.IsJumping())\r\n            return;\r\n        let move = this._abilityCtrl.GetAbility(EAbility.Move);\r\n        if (move == null)\r\n            return;\r\n        let velocity = this.getMoveVelocity(this._moveSpeed * mul, this.getForward());\r\n        move.DoMove(velocity, Vec3Util.ZERO, Vec3Util.ZERO, Callback.Create(this, this.DoIdle), Callback.Create(this, () => {\r\n            if (Player.Ins.Account.IsSelfId(this._worldData.userId)) {\r\n                this.sendCurSelfPosEulerInfo();\r\n            }\r\n        }));\r\n    }\r\n    sendCurSelfPosEulerInfo() {\r\n        let pos = this.localPos;\r\n        if (pos.y < -10) {\r\n            pos = this.ResetPos();\r\n            this.setLocalPos(pos);\r\n        }\r\n        let euler = this.obj_model.transform.localRotationEuler;\r\n        if (Vec3Util.IsZero(euler)) {\r\n            euler = new Laya.Vector3(0, 360, 0);\r\n        }\r\n        WorldClient.Ins.ReqUpdateSyncInfo(pos, euler);\r\n    }\r\n    RotateY(r) {\r\n        this.interruptAutoMove();\r\n        let cal = this.obj_center.transform.localRotationEulerY - r + 180;\r\n        this.setLocalEuler(new Laya.Vector3(0, cal, 0));\r\n    }\r\n    IsMoving() {\r\n        let move = this._abilityCtrl.GetAbility(EAbility.Move);\r\n        if (move == null)\r\n            return false;\r\n        return move.IsMoving;\r\n    }\r\n    getTargetEulerByTarPos(tarPos) {\r\n        let dir = Vec3Util.Subtract(new V3(tarPos.x, this.worldPos.y, tarPos.z), this.worldPos);\r\n        let nor_forward = Vec3Util.FORWARD;\r\n        let nor_dir = Vec3Util.Normalize(dir);\r\n        let euler = Vec3Util.DotToAngle(nor_forward, nor_dir);\r\n        let bNav = (this._targetPos.x - this.worldPos.x) > 0;\r\n        euler = bNav ? MathUtil.Abs(euler) : -MathUtil.Abs(euler);\r\n        return euler;\r\n    }\r\n    SetTargetPos(pos) {\r\n        if (this._timerItem != null) {\r\n            this.interruptAutoMove();\r\n        }\r\n        this._targetPos = pos;\r\n        let euler = this.getTargetEulerByTarPos(this._targetPos);\r\n        this.setLocalEuler(new Laya.Vector3(0, euler, 0));\r\n    }\r\n    interruptAutoMove() {\r\n        if (this._timerItem) {\r\n            TimerMgr.Ins.Remove(this._timerItem);\r\n            this._timerItem = null;\r\n        }\r\n        this._targetPos = null;\r\n    }\r\n    checkAutoMove() {\r\n        if (this._targetPos == null)\r\n            return;\r\n        let totalDis = Vec3Util.Distance(new V3(this._targetPos.x, this.worldPos.y, this._targetPos.z), this.worldPos);\r\n        let speed = this._moveSpeed * 1;\r\n        let velocity = this.getMoveVelocity(speed, this.getForward());\r\n        let moveDis = Vec3Util.Magnitude(velocity);\r\n        if (totalDis > moveDis && totalDis > 0.5) {\r\n            let euler = this.getTargetEulerByTarPos(this._targetPos);\r\n            this.setLocalEuler(new Laya.Vector3(0, euler, 0));\r\n            this.moveForward(1);\r\n        }\r\n        else {\r\n            this.moveForward(0);\r\n            this.sendCurSelfPosEulerInfo();\r\n            this.interruptAutoMove();\r\n        }\r\n    }\r\n    DoJump() {\r\n        if (this.IsJumping())\r\n            return;\r\n        if (this.IsMoving()) {\r\n            let move = this._abilityCtrl.GetAbility(EAbility.Move);\r\n            if (move == null)\r\n                return;\r\n            move.DoJump(Callback.Create(this, () => {\r\n                console.log(\"跳跃完成\");\r\n            }));\r\n        }\r\n        else {\r\n            let jump = this._abilityCtrl.GetAbility(EAbility.Jump);\r\n            if (jump == null)\r\n                return;\r\n            jump.DoJump(Callback.Create(this, () => {\r\n                console.log(\"跳跃完成\");\r\n            }));\r\n        }\r\n        if (Player.Ins.Account.IsSelfId(this._worldData.userId)) {\r\n            WorldClient.Ins.ReqUpdateJumpInfo();\r\n        }\r\n    }\r\n    IsJumping() {\r\n        let jump = this._abilityCtrl.GetAbility(EAbility.Jump);\r\n        if (jump == null)\r\n            return false;\r\n        return jump.IsJumping;\r\n    }\r\n    DoAction(actionId) {\r\n        if (this.IsJumping())\r\n            return;\r\n        let action = this._abilityCtrl.GetAbility(EAbility.Action);\r\n        if (action == null)\r\n            return;\r\n        action.DoAction(actionId);\r\n    }\r\n    onInitInteract() {\r\n        this.obj_interact = new Sprite3D(\"Trigger_Interact\");\r\n        this.Obj.addChild(this.obj_interact);\r\n        this.obj_interact.transform.localPosition = Vec3Util.ZERO;\r\n        this.triger_interact = this.obj_interact.addCo