   }\r\n}\r\nexport class AmaChatItemNodeShow extends RowMoveBaseNode {\r\n    constructor() {\r\n        super(...arguments);\r\n        this.clsKey = \"AmaChatItemNodeShow\";\r\n    }\r\n    createNode(index) {\r\n        let cellVo = this.list[index];\r\n        let tempCell = Laya.Pool.getItemByClass(this.clsKey, AmaChatItemShow);\r\n        tempCell.clsKey = this.clsKey;\r\n        tempCell.setData(cellVo);\r\n        tempCell.y = this.y;\r\n        return tempCell;\r\n    }\r\n}\r\nexport class AmaChatUtils {\r\n    static GetTmpCirleIcon(url) {\r\n        if (StringUtil.IsNullOrEmpty(url)) {\r\n            return `remote/main/home/img_head.png`;\r\n        }\r\n        return url;\r\n    }\r\n    static IsEmoj(str) {\r\n        let reg = /^[emoj:[0-9]+]/g;\r\n        let a = reg.test(str);\r\n        return a;\r\n    }\r\n    static GetEmojId(str) {\r\n        let patt2 = /[0-9]+/g;\r\n        let b = str.match(patt2);\r\n        return parseInt(b[0]);\r\n    }\r\n    static ShowTime(time) {\r\n        let server = TimeUtil.serverTime();\r\n        return TimeUtil.ShowTime(time, server);\r\n    }\r\n    static InitStyle(msgtf) {\r\n        msgtf.style.color = \"#ffffff\";\r\n        msgtf.style.fontSize = 18;\r\n        msgtf.style.font = \"bold\";\r\n        msgtf.style.width = 350;\r\n    }\r\n    static renderSmallTf(msgtf, data) {\r\n        this.InitStyle(msgtf);\r\n        msgtf.innerHTML = `${this.GetNickName(data.vo.UserInfo.nickName)}${data.vo.Content}`;\r\n    }\r\n    static GetNickName(nickName) {\r\n        return `<font color=\"#00ff00\">[${nickName}]</font>`;\r\n    }\r\n    static renderSmallTfNickName(msgtf, data) {\r\n        this.InitStyle(msgtf);\r\n        msgtf.innerHTML = this.GetNickName(data.vo.UserInfo.nickName);\r\n    }\r\n    static GetSmallLabelHeight(cellVo, clsKey) {\r\n        let tempCell = Laya.Pool.getItemByClass(clsKey, ui.views.main.ui_mainchatitemUI);\r\n        this.renderSmallTf(tempCell.msgtf, cellVo);\r\n        Laya.Pool.recover(clsKey, tempCell);\r\n        let h = tempCell.msgtf.contextHeight;\r\n        if (h < tempCell.img_content_self_bg.height) {\r\n            h = tempCell.img_content_self_bg.height;\r\n        }\r\n        return h;\r\n    }\r\n    static getCellHeight(cellVo) {\r\n        let clsKey = \"TmpChatItemView\";\r\n        let tempCell = Laya.Pool.getItemByClass(clsKey, ui.views.video.ui_ama_chatItemUI);\r\n        if (this.IsEmoj(cellVo.vo.Content)) {\r\n            return 110;\r\n        }\r\n        let h;\r\n        if (Player.Ins.Account.AccountU64Id.toString() == cellVo.vo.UuId) {\r\n            tempCell.lbl_content_self.text = cellVo.vo.Content;\r\n            h = tempCell.img_content_self_bg.y +\r\n                tempCell.lbl_content_self.y +\r\n                tempCell.lbl_content_self.textField.height;\r\n        }\r\n        else {\r\n            tempCell.lbl_content_remote.text = cellVo.vo.Content;\r\n            h = tempCell.img_content_remote_bg.y +\r\n                tempCell.lbl_content_remote.y +\r\n                tempCell.lbl_content_remote.textField.height;\r\n        }\r\n        if (h < tempCell.height) {\r\n            h = tempCell.height;\r\n        }\r\n        Laya.Pool.recover(clsKey, tempCell);\r\n        return h + this.GAP;\r\n    }\r\n}\r\nAmaChatUtils.GAP = 10;\r\nclass AmaChatViewShow extends ui.views.video.ui_ama_chatUI {\r\n    constructor() {\r\n        super();\r\n        this.scrollCtl = new ScrollPanelControl();\r\n        this.curTime = 0;\r\n        this.tempTick = 0;\r\n        this.scrollCtl.init(this.panel_chat);\r\n        this.btn_send.clickHandler = new Laya.Handler(this, this.onSendMsg);\r\n        this.input_text.maxChars = this.model.cfgMaxCharCnt + 1;\r\n        this.cdtf.text = '';\r\n        this.model.chatInputText = this.input_text.textField;\r\n        this.zhubobtn.on(Laya.Event.CLICK, this, this.onClickHandler);\r\n    }\r\n    get model() {\r\n        return VideoModel.getIns();\r\n    }\r\n    onClickHandler() {\r\n        this.model.openHost();\r\n    }\r\n    onChangeEvt() {\r\n        if (this.input_text.text.length >= this.model.cfgMaxCharCnt) {\r\n            E.ViewMgr.ShowMidLabel(E.LangMgr.GetLanguageLabel(\"Common\")[\"InputMuchMore\"]);\r\n        }\r\n    }\r\n    onSendMsg() {\r\n        if (this.model.curData.status == EAmaOpenStatus.Finished) {\r\n            E.ViewMgr.ShowMidError(E.LangMgr.getLang(EViewType.AmaChat, \"NotOpen\"));\r\n            return;\r\n        }\r\n        if (this.input_text.text != \"\") {\r\n            let req = new SendAmaChat_req();\r\n            req.SendContent = this.input_text.text;\r\n            SocketMgr.Ins.SendMessageBin(req);\r\n            this.input_text.text = \"\";\r\n        }\r\n        else {\r\n            E.ViewMgr.ShowMidLabel(E.LangMgr.GetLanguageLabel(\"AmaMain\")[\"PleaseInput\"]);\r\n        }\r\n    }\r\n    clearCD() {\r\n    }\r\n    getTween() {\r\n        if (this.tempTween) {\r\n            this.tempTween.clear();\r\n        }\r\n        else {\r\n            this.tempTween = new Laya.Tween();\r\n        }\r\n    }\r\n    onEnter() {\r\n        this.input_text.textField;\r\n        this.input_text.on(Laya.Event.INPUT, this, this.onChangeEvt);\r\n        Laya.stage.on(Laya.Event.KEY_DOWN, this, this.onKeyDown);\r\n        this.model.on(EAmaEvent.UpdateAmaStatus, this, this.onRefrsh);\r\n        this.model.emit(EAmaEvent.NtfMainCloseBtn);\r\n        this.refreshChatView();\r\n        this.clearCD();\r\n        this.getTween();\r\n        this.box_chat.x = this.width;\r\n        this.tempTween.to(this.box_chat, { x: 0 }, this.model.closeTime);\r\n        this.btn_flower2.on(Laya.Event.CLICK, this, this.onFlower);\r\n        this.btn_chapping.on(Laya.Event.CLICK, this, this.onChapping);\r\n        this.onRefrsh();\r\n    }\r\n    onKeyDown(e) {\r\n        if (Laya.stage.focus == this.input_text.textField && e.keyCode == Laya.Keyboard.ENTER) {\r\n            this.onSendMsg();\r\n        }\r\n 