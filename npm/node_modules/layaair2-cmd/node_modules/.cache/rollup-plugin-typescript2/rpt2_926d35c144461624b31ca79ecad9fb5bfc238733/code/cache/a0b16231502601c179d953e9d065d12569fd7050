rn pos;\r\n    }\r\n    onSelectResItem(data) {\r\n        if (data == null)\r\n            return;\r\n        let cfg = t_house_res_help.Ins.GetDataById(data.id);\r\n        let path = t_house_res_help.Ins.GetFullModelPath(cfg.f_path);\r\n        let pos = this.getRaycastCreateAreaPos(GameHelp.ScreenCenter);\r\n        if (pos == null) {\r\n            E.EventMgr.emit(HouseEventID.Msg_OnLoadResCompleted, null);\r\n            return;\r\n        }\r\n        this.createMesh(path, cfg, this.Scene3D, Callback.Create(this, (mesh) => {\r\n            E.EventMgr.emit(HouseEventID.Msg_OnLoadResCompleted, null);\r\n            let botPos = this.getGridBotPos(pos);\r\n            let tarEulerY = MapEditorHelper.GetEulerYByDir(this.getCurCameraDir());\r\n            let fillBoxWHL = this.getFillBoxWHL(mesh, botPos);\r\n            let meshPos = new V3(botPos.x, botPos.y, botPos.z);\r\n            mesh.SetPos(meshPos);\r\n            mesh.SetFillSizeX(fillBoxWHL.x);\r\n            mesh.SetFillSizeY(fillBoxWHL.y);\r\n            mesh.SetFillSizeZ(fillBoxWHL.z);\r\n            mesh.SetLocalEulerY(tarEulerY);\r\n            let canSetup = this.checkMeshCanSetup(mesh);\r\n            if (canSetup == false) {\r\n                let pos = this.getCanSetupPos(mesh);\r\n                if (pos == null) {\r\n                    mesh.SetCanSetup(false);\r\n                }\r\n                else {\r\n                    mesh.SetCanSetup(true);\r\n                }\r\n            }\r\n            else\r\n                mesh.SetCanSetup(true);\r\n            this.setSelectMesh(mesh);\r\n        }));\r\n    }\r\n    getFillBoxWHL(mesh, botCenter) {\r\n        let meshSize = mesh.MeshSize();\r\n        let meshMin = new V3(this.formatNum2(botCenter.x - meshSize.x / 2.0), this.formatNum2(botCenter.y), this.formatNum2(botCenter.z - meshSize.z / 2.0));\r\n        let meshMax = new V3(this.formatNum2(botCenter.x + meshSize.x / 2.0), this.formatNum2(botCenter.y + meshSize.y), this.formatNum2(botCenter.z + meshSize.z / 2.0));\r\n        let meshGridMin = MapEditorHelper.GetGridOrigin(meshMin);\r\n        let meshGridMax = MapEditorHelper.GetGridMax(meshMax);\r\n        let fillBoxW = meshGridMax.x - meshGridMin.x;\r\n        let fillBoxH = meshGridMax.y - meshGridMin.y;\r\n        let fillBoxL = meshGridMax.z - meshGridMin.z;\r\n        return new V3(fillBoxW, fillBoxH, fillBoxL);\r\n    }\r\n    onInit3D() {\r\n        this._camera = this.Scene3D.getChildByName(\"Main Camera\");\r\n        this._dirLight = this.Scene3D.getChildByName(\"Directional Light\");\r\n        this._camera.clearColor = new Laya.Vector4();\r\n        this._dirLight.intensity = 1.3;\r\n        let dirlight = new Laya.DirectionLight();\r\n        this.Scene3D.addChild(dirlight);\r\n        dirlight.transform.localPosition = Vec3Util.ZERO;\r\n        dirlight.transform.localRotationEuler = new Laya.Vector3(this._dirLight.transform.localRotationEulerX, this._dirLight.transform.localRotationEulerY + 180, this._dirLight.transform.localRotationEulerZ + 0);\r\n        this.outHitResult = null;\r\n        this._cameraRotateSpeed = 0.2;\r\n        this._cameraTranlateSpeed = 0.0015;\r\n        this.totalLen = 50;\r\n        this.initRootMesh();\r\n        let center = Vec3Util.ZERO;\r\n        this.initHouseMode();\r\n    }\r\n    onClear3D() {\r\n        this._camera = null;\r\n        this._dirLight = null;\r\n    }\r\n    createObj(path, parent = null, pos = null, complete = null) {\r\n        E.ResMgr.LoadU3D_LH(path, Callback.Create(this, (obj) => {\r\n            if (parent)\r\n                parent.addChild(obj);\r\n            if (pos)\r\n                obj.transform.localPosition = pos;\r\n            if (complete != null)\r\n                complete.Invoke(obj);\r\n        }));\r\n    }\r\n    onCameraDisChange() {\r\n        if (this.IsBuildingMode) {\r\n            this.onBuildingModeCameraDisChange();\r\n        }\r\n        else if (this.IsVisitingMode) {\r\n        }\r\n    }\r\n    drawMeshGrid() {\r\n        let stepLen = MapEditorHelper.MinStepLen;\r\n        if (MapEditorHelper.CurStepLen != stepLen) {\r\n            MapEditorHelper.drawMeshPixelLines(this.Scene3D, stepLen * 100, stepLen * 100, stepLen);\r\n        }\r\n    }\r\n    drawPixelAxis() {\r\n        let stepLen = MapEditorHelper.MinStepLen;\r\n        MapEditorHelper.DrawAxis(this.Scene3D, true, true, true, stepLen, this.totalLen);\r\n    }\r\n    OnMouseDown(e) { this.onMouseDownHandler(e); }\r\n    OnMouseMove(e) { this.onMouseMoveHandler(e); }\r\n    OnMouseUp(e) { this.onMouseUpHandler(e); }\r\n    OnMouseOut(e) { this.onMouseOutHandler(e); }\r\n    OnRightMouseDown(e) { this.onRightMouseDownHandler(e); }\r\n    OnRightMouseUp(e) { this.onRightMouseUpHandler(e); }\r\n    OnMouseWheel(e) { this.onMouseWheelHandler(e); }\r\n    OnKeyCodeDown(e) { this.onKeyCodeDownHandler(e); }\r\n    onMouseDownHandler(e) {\r\n        let curClickTime = DateUtil.GetNowMS();\r\n        let clickDuration = curClickTime - this._lastClickTime;\r\n        console.log(\"clickDuration:\" + clickDuration);\r\n        if (BrowserUtil.IsPc) {\r\n            this.onPCMouseDown(e, clickDuration);\r\n        }\r\n        else {\r\n            this.onMobileMouseDown(e, clickDuration);\r\n        }\r\n        this._lastClickTime = curClickTime;\r\n    }\r\n    onMouseMoveHandler(e) {\r\n        if (BrowserUtil.IsPc) {\r\n            this.onPCMouseMove(e);\r\n        }\r\n        else {\r\n            this.onMobileMouseMove(e);\r\n        }\r\n    }\r\n    onMouseUpHandler(e) {\r\n        if (this.isAddClickEventTimer && this._curSelectMesh == null) {\r\n            this.addClickEventTimer();\r\n            this.isAddClickEventTimer = false;\r\n        }\r\n        if (BrowserUtil.IsPc) {\r\n            this.onPCMouseUp(e);\r\n        }\r\n        else {\r\n            this.onMobileMouseUp(e);\r\n        }\r\n    }\r\n    onMouseOutHandler(e) {\r\n        if (BrowserUtil.IsPc) {\r\n            this.onPCMouseOut(e);\r\n        }\r\n        else {\r\n            this.onMobileMouseOut(e);\r\n        }\r\n    }\r\n    onRightMouseDownHandler(e) {\r\n        if (BrowserUtil.IsPc) {\r\n            this._isRightMouseDown = true;\r\n            this._touchPosFirst = GameHelp.StageMousePos;\r\n        }\r\n    }\r\n    onRightMouseUpHandler(e) {\r\n        if (BrowserUtil.IsPc) {\r\n            this._isRightMouseDown = false;\r\n        }\r\n    }\r\n    onMouseWheelHandler(e) {\r\n        if (BrowserUtil.IsPc) {\r\n            if (this.IsBuildingMode) {\r\n                this.scaleCamera(e.delta);\r\n            }\r\n            else if (this.IsVisitingMode) {\r\n            }\r\n        }\r\n    }\r\n    onKeyCodeDownHandler(e) {\r\n        if (Laya.Keyboard.LEFTBRACKET == e.keyCode) {\r\n            this.rotateCamera(new V2(-5, 0));\r\n        }\r\n        else if (Laya.Keyboard.RIGHTBRACKET == e.keyCode) {\r\n            this.rotateCamera(new V2(5, 0));\r\n        }\r\n    }\r\n    isDoubleClick(duration) {\r\n        return duration > 0 && duration < this._minDoubleClickTime;\r\n    }\r\n    onPCMouseDown(e, clickDuration) {\r\n        this._isLeftMouseDown = true;\r\n        this._touchPosFirst = GameHelp.StageMousePos;\r\n        console.log(\"当前鼠标左键点击位置 m.x\" + this._touchPosFirst.x + \" m.y:\" + this._touchPosFirst.y);\r\n        if (this.IsBuildingMode) {\r\n            this.onBuildingModeClickHandler(this._touchPosFirst, clickDuration);\r\n        }\r\n        else if (this.IsVisitingMode) {\r\n        }\r\n    }\r\n    onPCMouseUp(e) {\r\n        this._isLeftMouseDown = false;\r\n        if (this.IsBuildingMode) {\r\n            this.OnSelectMeshMoveFinished();\r\n        }\r\n        else if (this.IsVisitingMode) {\r\n        }\r\n    }\r\n    onPCMouseOut(e) {\r\n        this._isLeftMouseDown = false;\r\n        this._isRightMouseDown = false;\r\n        if (this.IsBuildingMode) {\r\n            this.OnSelectMeshMoveFinished();\r\n        }\r\n        else if (this.IsVisitingMode) {\r\n        }\r\n    }\r\n    onPCMouseMove(e) {\r\n        if (!this._isLeftMouseDown && !this._isRightMouseDown)\r\n            return;\r\n        let nowPoint = GameHelp.StageMousePos;\r\n        let offset = new Laya.Vector2(nowPoint.x - this._touchPosFirst.x, nowPoint.y - this._touchPosFirst.y);\r\n        this._touchPosFirst = GameHelp.StageMousePos;\r\n        let offsetLen = Vec2Util.Length(offset);\r\n        if (offsetLen == 0)\r\n            return;\r\n        if (this.isAddClickEventTimer)\r\n            this.isAddClickEventTimer = false;\r\n        if (this.IsBuildingMode) {\r\n            this.onBuildingModeMouseMoveHandler(offset, nowPoint);\r\n        }\r\n        else if (this.IsVisitingMode) {\r\n        }\r\n    }\r\n    onMobileMouseDown(e, clickDuration) {\r\n        let touchCount = e.touches.length;\r\n        if (touchCount <= 0) {\r\n            touchCount = 0;\r\n            return;\r\n        }\r\n        if (touchCount == 1) {\r\n            this.onOneTouchDown(e, clickDuration);\r\n        }\r\n        else if (touchCount == 2) {\r\n            this.onTwoTouchDown(e);\r\n        }\r\n        else if (touchCount == 3) {\r\n            this.onThreeTwoDown(e, clickDuration);\r\n        }\r\n        this._lastTochCount = touchCount;\r\n    }\r\n    onOneTouchDown(e, clickDuration) {\r\n        this._touchPosFirst = new V2(e.touches[0].stageX, e.touches[0].stageY);\r\n        if (this.IsBuildingMode) {\r\n            this.onBuildingModeClickHandler(this._touchPosFirst, clickDuration);\r\n        }\r\n        else if (this.IsVisitingMode) {\r\n        }\r\n    }\r\n    onTwoTouchDown(e) {\r\n        this._touchPosFirst = new V2(e.touches[0].stageX, e.touches[0].stageY);\r\n        this._touchPosSecond = new V2(e.touches[1].stageX, e.touches[1].stageY);\r\n        this._lastTwoTouchDis = Vec2Util.Distance(this._touchPosFirst, this._touchPosSecond);\r\n    }\r\n    onThreeTwoDown(e, clickDuration) {\r\n        if (this.isDoubleClick(clickDuration)) {\r\n            if (this.IsBuildingMode) {\r\n                this.removeClickEventTimer();\r\n                this.resetCamera();\r\n            }\r\n            else if (this.IsVisitingMode) {\r\n            }\r\n        }\r\n    }\r\n    onMobileMouseUp(e) {\r\n        this._lastTochCount = 0;\r\n        this.OnSelectMeshMoveFinished();\r\n    }\r\n    onMobileMouseOut(e) {\r\n        this._lastTochCount = 0;\r\n    }\r\n    onMobileMouseMove(e) {\r\n        if (e.touches == null)\r\n            return;\r\n        let touchCount = e.touches.length;\r\n        if (touchCount == this._lastTochCount) {\r\n            if (this._lastTochCount == 1) {\r\n                this.onOneTouchMove(e);\r\n            }\r\n            else if (this._lastTochCount == 2) {\r\n                this.onTwoTouchMove(e);\r\n            }\r\n            else if (this._lastTochCount == 3) {\r\n            }\r\n        }\r\n    }\r\n    onOneTouchMove(e) {\r\n        let curPos = new V2(e.touches[0].stageX, e.touches[0].stageY);\r\n        let delta = new V2(curPos.x - this._touchPosFirst.x, curPos.y - this._touchPosFirst.y);\r\n        if (this.IsBuildingMode) {\r\n            this.onBuildingModeMobileTouchOneMoveHandler(delta, curPos);\r\n        }\r\n        else if (this.IsVisitingMode) {\r\n        }\r\n        this._touchPosFirst = curPos;\r\n    }\r\n    onTwoTouchMove(e) {\r\n        let firstPoint = new V2(e.touches[0].stageX, e.touches[0].stageY);\r\n        let secondPoint = new V2(e.touches[1].stageX, e.touches[1].stageY);\r\n        let dis = Vec2Util.Distance(firstPoint, secondPoint);\r\n        let offset = dis - this._lastTwoTouchDis;\r\n        let v1 = Vec2Util.Subtract(firstPoint, this._touchPosFirst);\r\n        let v2 = Vec2Util.Subtract(secondPoint, this._touchPosSecond);\r\n        let dot = Vec2Util.Dot(v1, v2);\r\n        if (this.IsBuildingMode) {\r\n            this.onBuildingModeMobileTouchTwoMoveHandler(dot, offset, firstPoint);\r\n        }\r\n        else {\r\n        }\r\n        this._touchPosFirst = firstPoint;\r\n        this._touchPosSecond = secondPoint;\r\n        this._lastTwoTouchDis = dis;\r\n    }\r\n    addClickEventTimer() {\r\n        if (this.clickEventTimer == null) {\r\n            this.clickEventTimer = TimerMgr.Ins.Add(this, 30, 1, null, this.clickEventHandler, false);\r\n        }\r\n    }\r\n    removeClickEventTimer() {\r\n        if (this.clickEventTimer != null) {\r\n            TimerMgr.Ins.Remove(this.clickEventTimer);\r\n            this.clickEventTimer = null;\r\n        }\r\n    }\r\n    clickEventHandler() {\r\n        console.log(\"点击事件\");\r\n        this.removeClickEventTimer();\r\n        if (this.IsBuildingMode) {\r\n            this.trySelectMesh(this._lastClickMesh);\r\n        }\r\n    }\r\n    initRootMesh() {\r\n        let config = t_house_res_help.Ins.GetDataByPath(\"house1/land\");\r\n        this.createMesh(t_house_res_help.Ins.GetFullModelPath(\"house1/land\"), config, this.Scene3D, Callback.Create(this, (mesh) => {\r\n            this._rootMesh = mesh;\r\n        }));\r\n    }\r\n    instanceMesh(path, config, obj, parent) {\r\n        let mesh = new MeshUnit(path, config, obj, this.Scene3D);\r\n        parent.addChild(mesh.GetObj());\r\n        this.addToMeshesList(mesh);\r\n        return mesh;\r\n    }\r\n    createMesh(path, config, parent, callback) {\r\n        if (StringUtil.IsNullOrEmpty(path))\r\n            return;\r\n        this.createObj(path, null, null, Callback.Create(this, (obj) => {\r\n            let mesh = this.instanceMesh(path, config, obj, parent);\r\n            if (callback)\r\n                callback.Invoke(mesh);\r\n        }));\r\n    }\r\n    addToMeshesList(mesh) {\r\n        ListUtil.Add(this._meshes, mesh);\r\n    }\r\n    destroyMesh(mesh) {\r\n        if (mesh != null) {\r\n            ListUtil.Remove(this._meshes, mesh);\r\n            mesh.OnDestory();\r\n            mesh = null;\r\n        }\r\n    }\r\n    trySelectMesh(mesh) {\r\n        if (mesh == null)\r\n            return;\r\n        if (mesh == this._rootMesh)\r\n            return;\r\n        this.setSelectMesh(mesh);\r\n    }\r\n    setSelectMesh(mesh) {\r\n        if (this._curSelectMesh == mesh)\r\n            return;\r\n        if (this._curSelectMesh != null) {\r\n            this._curSelectMesh.ShowFillBox(false);\r\n        }\r\n        this._curSelectMesh = mesh;\r\n        if (this._curSelectMesh != null) {\r\n            this._curSelectMesh.ShowFillBox(true);\r\n            this.cameraFocusMesh(this._curSelectMesh);\r\n        }\r\n        this.emitMoveSelectMeshPos();\r\n    }\r\n    preMoveSelectMesh(delta, curTouchPos) {\r\n        let tarPos = null;\r\n        let moveDir = EDirection.None;\r\n        let tarEulerY = MapEditorHelper.GetEulerYByDir(this.getCurCameraDir());\r\n        let optionDir = EDirection.None;\r\n        let distance = 0;\r\n        if (MathUtil.Abs(delta.x) > MathUtil.Abs(delta.y)) {\r\n            delta.y = 0;\r\n            distance = MathUtil.Abs(delta.x);\r\n        }\r\n        else {\r\n            delta.x = 0;\r\n            distance = MathUtil.Abs(delta.y);\r\n        }\r\n        let dis = NumberUtil.ToInt(distance / 2);\r\n        if (dis < 1) {\r\n            return;\r\n        }\r\n        if (delta.x != 0) {\r\n            if (delta.x > 0)\r\n                optionDir = EDirection.Right;\r\n            else if (delta.x < 0)\r\n                optionDir = EDirection.Left;\r\n        }\r\n        else if (delta.y != 0) {\r\n            if (delta.y > 0)\r\n                optionDir = EDirection.Back;\r\n            else if (delta.y < 0)\r\n                optionDir = EDirection.Forward;\r\n        }\r\n        if (optionDir == EDirection.None)\r\n            return;\r\n        if (tarEulerY == 0) {\r\n            moveDir = optionDir;\r\n        }\r\n        else if (tarEulerY == 90) {\r\n            if (optionDir == EDirection.Forward)\r\n                mo