{"code":"import TimeUtil from \"../../../../../frame/util/TimeUtil\";\r\nimport { ui } from \"../../../../../ui/layaMaxUI\";\r\nimport { EPurseType } from \"../../../../common/defines/EnumDefine\";\r\nimport { E } from \"../../../../G\";\r\nimport { EBusinessExchangeWay, EBusinessExpectPurse, EBusinessTransType } from \"../../bank/vos/BankVo\";\r\nimport SocketMgr from \"../../../../network/SocketMgr\";\r\nimport { Player } from \"../../../../player/Player\";\r\nimport { BussinessEvent } from \"../crl/BussinessEvent\";\r\nimport { BussinessModel } from \"../crl/BussinessModel\";\r\nimport { SecSliderControl } from \"../crl/SliderControl\";\r\nimport { BussinessTabelVo, EBusinessPlayerState, EBusinessType, EHisType } from \"../vos/BussinessVo\";\r\nimport { TabelNodeItem } from \"./TabelNodeItem\";\r\nimport { TabelView } from \"./TabelView\";\r\nimport { BusinessAddTransPair_req, BusinessDelTransPair_req, BusinessGetLineData_req, BusinessGetData_req } from \"../../../../network/protocols/BusinessProto\";\r\nclass ITabSelect {\r\n}\r\nvar EMoneyType;\r\n(function (EMoneyType) {\r\n    EMoneyType[EMoneyType[\"MAKE\"] = 1] = \"MAKE\";\r\n    EMoneyType[EMoneyType[\"USDT\"] = 2] = \"USDT\";\r\n})(EMoneyType || (EMoneyType = {}));\r\nclass MoneyControl {\r\n    constructor(img, label) {\r\n        this.img = img;\r\n        this.label = label;\r\n    }\r\n    setVlaue(type, value) {\r\n        if (type == EMoneyType.MAKE) {\r\n            this.img.skin = `remote/business/money1.png`;\r\n        }\r\n        else {\r\n            this.img.skin = `remote/business/money2.png`;\r\n        }\r\n        this.label.text = value.toString();\r\n    }\r\n}\r\nclass HisItemView extends ui.views.business.ui_business_jl_itemUI {\r\n    constructor() {\r\n        super();\r\n        this.makePosX = this.s1.x;\r\n        this.usdtPosX = this.s2.y;\r\n        this.model = BussinessModel.getIns();\r\n        this.leftMoney = new MoneyControl(this.s1.icon, this.s1.valueTf);\r\n        this.rightMoney = new MoneyControl(this.s2.icon, this.s2.valueTf);\r\n        this.s2.nameTf.text = \"USDT\";\r\n        this.s2.nameTf.color = \"#00ff00\";\r\n    }\r\n    clear() {\r\n        this.arrow.visible = false;\r\n        this.left1.visible = false;\r\n        this.t1.text = \"\";\r\n        this.lefticon.visible = false;\r\n    }\r\n    setMakeToU(v) {\r\n        this.lefticon.x = this.t1.x + this.t1.textField.width;\r\n        if (v) {\r\n            this.maketf.x = 0;\r\n            this.signtf.x = this.maketf.x + this.maketf.textField.width;\r\n            this.usdtTf.x = this.signtf.x + this.signtf.textField.width;\r\n        }\r\n        else {\r\n            this.usdtTf.x = 0;\r\n            this.signtf.x = this.usdtTf.x + this.usdtTf.textField.width;\r\n            this.maketf.x = this.signtf.x + this.signtf.textField.width;\r\n        }\r\n    }\r\n    setData(vo) {\r\n        this.clear();\r\n        this.leftMoney.setVlaue(EMoneyType.MAKE, vo.make);\r\n        this.rightMoney.setVlaue(EMoneyType.USDT, vo.usdt);\r\n        if (vo.type == EHisType.Exchange) {\r\n            this.arrow.visible = true;\r\n            let exchangeVo = vo;\r\n            let _status = false;\r\n            this.t2.text = this.model.getLang(\"ChargePayMoney\") + \":\" + exchangeVo.chargePayMoney;\r\n            if (exchangeVo.way == EBusinessExchangeWay.MToU) {\r\n                this.s1.x = this.makePosX;\r\n                this.s2.y = this.usdtPosX;\r\n                this.t1.text = this.model.getLang(\"Price\") + \":\";\r\n                _status = true;\r\n            }\r\n            else {\r\n                this.s2.x = this.makePosX;\r\n                this.s1.y = this.usdtPosX;\r\n                this.t1.text = this.model.getLang(\"Price\") + \":\";\r\n            }\r\n            this.lefticon.visible = true;\r\n            this.setMakeToU(_status);\r\n        }\r\n        else if (vo.type == EHisType.Flow) {\r\n            this.t1.text = \"\";\r\n        }\r\n        else if (vo.type == EHisType.Business) {\r\n            if (vo.way1 == EBusinessTransType.Add) {\r\n                this.t1.text = this.model.getLang(\"AddFlow\");\r\n            }\r\n            else if (vo.way1 == EBusinessTransType.Del) {\r\n                this.t1.text = this.model.getLang(\"SubFlow\");\r\n            }\r\n            else {\r\n                this.t1.text = \"\";\r\n            }\r\n        }\r\n        else {\r\n            this.t1.text = \"\";\r\n        }\r\n        let s = TimeUtil.timestamtoTime(vo.time);\r\n        this.t3.text = s;\r\n    }\r\n}\r\nclass BussinessTabBtn {\r\n    constructor() {\r\n        this.btns = [];\r\n    }\r\n    push(btn) {\r\n        btn.clickHandler = new Laya.Handler(this, this.onClick, [this.btns.length]);\r\n        this.btns.push(btn);\r\n    }\r\n    onClick(index) {\r\n        this.selectIndex = index;\r\n        if (this.selectEffect) {\r\n            for (let i = 0; i < this.btns.length; i++) {\r\n                this.selectEffect.runWith({ selected: i == index, btn: this.btns[i] });\r\n            }\r\n        }\r\n        this.selectHandler.runWith(index);\r\n    }\r\n    setSelectIndex(index) {\r\n        this.onClick(index);\r\n    }\r\n}\r\nclass DuiHuangControl {\r\n    constructor(skin) {\r\n        this.skin = skin;\r\n        this.skin.make_input1.icon.skin = \"remote/business/money1.png\";\r\n        this.skin.usdt_input2.icon.skin = \"remote/business/money2.png\";\r\n        this.skin.duihuanbtn.clickHandler = new Laya.Handler(this, this.onDuihanHandler);\r\n        this.skin.make_input1.tf.text = \"MAKE\";\r\n        this.skin.usdt_input2.tf.text = \"USDT\";\r\n        this.initUI(this.skin.make_input1, this.onMakeInputChange);\r\n        this.initUI(this.skin.usdt_input2, this.onUsdtInputChange);\r\n        this.skin.switchBtn.clickHandler = new Laya.Handler(this, this.onSwitchHandler);\r\n        this.curWay = EBusinessExchangeWay.MToU;\r\n    }\r\n    initUI(ui, func) {\r\n        const w = 180;\r\n        ui.input1.width = w - ui.icon.width;\r\n        ui.bg.width = w;\r\n        ui.input1.restrict = \"0-9\";\r\n        ui.input1.text = \"0\";\r\n        ui.input1.on(Laya.Event.INPUT, this, func);\r\n    }\r\n    onSwitchHandler() {\r\n        let ox = this.skin.make_input1.x;\r\n        let oy = this.skin.make_input1.y;\r\n        this.skin.make_input1.x = this.skin.usdt_input2.x;\r\n        this.skin.make_input1.y = this.skin.usdt_input2.y;\r\n        this.skin.usdt_input2.x = ox;\r\n        this.skin.usdt_input2.y = oy;\r\n        if (this.curWay == EBusinessExchangeWay.MToU) {\r\n            this.curWay = EBusinessExchangeWay.UToM;\r\n        }\r\n        else {\r\n            this.curWay = EBusinessExchangeWay.MToU;\r\n        }\r\n    }\r\n    onMakeInputChange() {\r\n        BussinessModel.getIns().curExpectPurse = EBusinessExpectPurse.Make;\r\n        let n = parseInt(this.skin.make_input1.input1.text);\r\n        if (isNaN(n)) {\r\n            this.skin.usdt_input2.input1.text = \"\";\r\n            return;\r\n        }\r\n        let usdt = n * BussinessModel.getIns().getMakePercent();\r\n        this.skin.usdt_input2.input1.text = Math.floor(usdt).toString();\r\n    }\r\n    onUsdtInputChange() {\r\n        BussinessModel.getIns().curExpectPurse = EBusinessExpectPurse.Usdt;\r\n        let n = parseInt(this.skin.usdt_input2.input1.text);\r\n        if (isNaN(n)) {\r\n            this.skin.make_input1.input1.text = \"\";\r\n            return;\r\n        }\r\n        let make = n / BussinessModel.getIns().getMakePercent();\r\n        this.skin.make_input1.input1.text = Math.floor(make).toString();\r\n    }\r\n    onDuihanHandler() {\r\n        BussinessModel.getIns().onExchange(this.curWay, parseInt(this.skin.make_input1.input1.text), parseInt(this.skin.usdt_input2.input1.text));\r\n    }\r\n}\r\nclass TouFangCheXiaoControl {\r\n    constructor(skin) {\r\n        this.model = BussinessModel.getIns();\r\n        this.skin = skin;\r\n        this.makeSlider = new SecSliderControl(this.skin.s1.p, this.skin.s1.bg, new Laya.Handler(this, this.onMakeSlider));\r\n        this.makeSlider.input = this.skin.top1.input1;\r\n        this.usdtSlider = new SecSliderControl(this.skin.s2.p, this.skin.s2.bg, new Laya.Handler(this, this.onUsdtSlider));\r\n        this.usdtSlider.input = this.skin.bottom1.input1;\r\n        this.skin.top1.icon.skin = \"remote/business/money1.png\";\r\n        this.skin.top1.tf.text = \"MAKE\";\r\n        this.skin.bottom1.icon.skin = \"remote/business/money2.png\";\r\n        this.skin.bottom1.tf.text = \"USDT\";\r\n        this.skin.toufangbtn.clickHandler = new Laya.Handler(this, this.onTouFangHandler);\r\n        this.skin.huishoubtn.clickHandler = new Laya.Handler(this, this.onHuiShouHandler);\r\n    }\r\n    onTouFangHandler() {\r\n        let make = this.makeSlider.getValue() * this.maxMake;\r\n        if (make > Player.Ins.Purse.GetPurse(EPurseType.MAKE)) {\r\n            E.ViewMgr.ShowMidLabel(this.model.getLang(\"MakeMoneyNotEnough\"));\r\n            return;\r\n        }\r\n        let usdt = this.usdtSlider.getValue() * this.maxUsdt;\r\n        if (usdt > Player.Ins.Purse.GetPurse(EPurseType.USDT)) {\r\n            E.ViewMgr.ShowMidLabel(this.model.getLang(\"UsdtMoneyNotEnough\"));\r\n            return;\r\n        }\r\n        let obj = new BusinessAddTransPair_req();\r\n        obj.purse1 = make;\r\n        obj.purse2 = usdt;\r\n        obj.type = EBusinessType.MAKEOrUSDT;\r\n        SocketMgr.Ins.SendMessageBin(obj);\r\n        this.skin.toufang_cexiao.visible = false;\r\n    }\r\n    onHuiShouHandler() {\r\n        let make = this.makeSlider.getValue() * this.maxMake;\r\n        let usdt = this.usdtSlider.getValue() * this.maxUsdt;\r\n        let obj = new BusinessDelTransPair_req();\r\n        obj.purse1 = make;\r\n        obj.purse2 = usdt;\r\n        obj.type = EBusinessType.MAKEOrUSDT;\r\n        SocketMgr.Ins.SendMessageBin(obj);\r\n        this.skin.toufang_cexiao.visible = false;\r\n    }\r\n    onMakeSlider(v) {\r\n        let value = this.maxMake * v;\r\n        let needUSDT = value * this.model.vo.curPrice;\r\n        this.usdtSlider.setValue(needUSDT / this.maxUsdt);\r\n        this.updateBot();\r\n    }\r\n    updateBot() {\r\n        let value = this.maxMake * this.makeSlider.getValue();\r\n        this.skin.tc_duihuan_tf5.text = (value / (this.model.vo.totalPurse1 + value) * 100).toFixed(6) + \"%\";\r\n    }\r\n    onUsdtSlider(v) {\r\n        let value = (this.maxUsdt * v);\r\n        let needMake = value / this.model.vo.curPrice;\r\n        this.makeSlider.setValue(needMake / this.maxMake);\r\n        this.updateBot();\r\n    }\r\n    open(v, make) {\r\n        let usdt = make * this.model.vo.curPrice;\r\n        this.maxMake = make;\r\n        this.maxUsdt = usdt;\r\n        this.isTouFang = v;\r\n        this.skin.toufang_cexiao.visible = true;\r\n        if (v) {\r\n            this.skin.huishoubtn.visible = false;\r\n            this.skin.toufangbtn.visible = true;\r\n            this.skin.tc_duihuan_tf.visible = true;\r\n        }\r\n        else {\r\n            this.skin.huishoubtn.visible = true;\r\n            this.skin.toufangbtn.visible = false;\r\n            this.skin.tc_duihuan_tf.visible = false;\r\n        }\r\n        this.makeSlider.setValue(0);\r\n        this.usdtSlider.setValue(0);\r\n        this.makeSlider.maxValue = make;\r\n        this.usdtSlider.maxValue = usdt;\r\n        this.updateBot();\r\n    }\r\n}\r\nexport class ViewBussiness extends ui.views.business.ui_business_mainUI {\r\n    constructor() {\r\n        super();\r\n        this.tabBtn = new BussinessTabBtn();\r\n        this.topTab = new BussinessTabBtn();\r\n        this.bIsMakeToUSDT = true;\r\n        this.model = BussinessModel.getIns();\r\n        this.tabBtn.push(this.btn10);\r\n        this.tabBtn.push(this.btn11);\r\n        this.tabBtn.push(this.btn12);\r\n        this.tabBtn.push(this.btn13);\r\n        this.tabBtn.selectHandler = new Laya.Handler(this, this.onSelectHandler);\r\n        this.tbView = new TabelView(this.con.width, this.con.height, TabelNodeItem, \"TabelNodeItem\");\r\n        this.con.addChild(this.tbView);\r\n        this.tipsbtn.clickHandler = new Laya.Handler(this, this.onHelpHandler);\r\n        this.jiaoyibtn.on(Laya.Event.CLICK, this, this.onClickJiaoYiHis);\r\n        this.closebtn.clickHandler = new Laya.Handler(this, this.onCloseSys);\r\n        this.topTab.push(this.duihuan_btn);\r\n        this.topTab.push(this.liudongxin_btn);\r\n        this.topTab.selectHandler = new Laya.Handler(this, this.onTopSelectHandler);\r\n        this.topTab.selectEffect = new Laya.Handler(this, this.onSelectEffect);\r\n        this.duihuan = new DuiHuangControl(this);\r\n        this.btn2.clickHandler = new Laya.Handler(this, this.onFluidHandler);\r\n        this.btn3.clickHandler = new Laya.Handler(this, this.onSubFluidHandler);\r\n        this.tc_closeBtn.clickHandler = new Laya.Handler(this, this.onTcCloseHandler);\r\n        this.switchbtn.clickHandler = new Laya.Handler(this, this.onSwitchClick);\r\n        this.toufan = new TouFangCheXiaoControl(this);\r\n        this.jiaoyibtn.on(Laya.Event.CLICK, this, this.onJiaoyiJilu);\r\n        this.l1.itemRender = HisItemView;\r\n        this.l1.renderHandler = new Laya.Handler(this, this.onRenderHander);\r\n        this.l1.vScrollBarSkin = \"\";\r\n        this.jlclosebtn.clickHandler = new Laya.Handler(this, this.onCloseJiaoyi);\r\n        this.t4.on(Laya.Event.CLICK, this, this.onFlowHandler);\r\n        this.t9.on(Laya.Event.CLICK, this, this.onFlowHandler);\r\n    }\r\n    onFlowHandler() {\r\n        this.openByType(EHisType.Flow);\r\n    }\r\n    onCloseJiaoyi() {\r\n        this.jiaoyi.visible = false;\r\n    }\r\n    onRenderHander(item, index) {\r\n        item.setData(item.dataSource);\r\n    }\r\n    onJiaoyiJilu() {\r\n        this.openByType(this.topTab.selectIndex == 0 ? EHisType.Exchange : EHisType.Business);\r\n    }\r\n    openByType(type) {\r\n        this.jiaoyi.visible = true;\r\n        if (type == EHisType.Exchange) {\r\n            this.jiaoyititle.text = this.model.getLang(\"DuihuanJilu\");\r\n        }\r\n        else if (type == EHisType.Flow) {\r\n            this.jiaoyititle.text = this.model.getLang(\"FlowTitle\");\r\n        }\r\n        else {\r\n            this.jiaoyititle.text = this.model.getLang(\"JiaoyiJilu\");\r\n        }\r\n        this.l1.array = [];\r\n        this.model.openHisCallBack(type);\r\n    }\r\n    onGetFlowList(list) {\r\n        this.l1.array = list || [];\r\n        this.l1.scrollTo(0);\r\n    }\r\n    onSwitchClick() {\r\n        let x = this.maketf1.x;\r\n        let y = this.maketf1.y;\r\n        this.maketf1.x = this.usdttf1.x;\r\n        this.maketf1.y = this.usdttf1.y;\r\n        this.usdttf1.x = x;\r\n        this.usdttf1.y = y;\r\n        this.bIsMakeToUSDT = !this.bIsMakeToUSDT;\r\n        console.log(\"onSwitchClick bIsMakeToUSDT:\" + this.bIsMakeToUSDT);\r\n        this.updateLineView();\r\n    }\r\n    onTcCloseHandler() {\r\n        this.toufang_cexiao.visible = false;\r\n    }\r\n    onSubFluidHandler() {\r\n        this.toufan.open(false, this.model.vo.selfPurse1);\r\n    }\r\n    onFluidHandler() {\r\n        this.toufan.open(true, Player.Ins.Purse.GetPurse(EPurseType.MAKE));\r\n    }\r\n    onTopSelectHandler(index) {\r\n        if (index == 0) {\r\n            this.duihuanbg4.visible = true;\r\n            this.liudongbg3.visible = false;\r\n            this.jiaoyibtn.text = this.model.getLang(\"DuihuanJilu\");\r\n        }\r\n        else {\r\n            this.duihuanbg4.visible = false;\r\n            this.liudongbg3.visible = true;\r\n            this.jiaoyibtn.text = this.model.getLang(\"JiaoyiJilu\");\r\n        }\r\n    }\r\n    onSelectEffect(obj) {\r\n        if (obj.selected) {\r\n            obj.btn.skin = \"remote/business/btn2.png\";\r\n        }\r\n        else {\r\n            obj.btn.skin = \"