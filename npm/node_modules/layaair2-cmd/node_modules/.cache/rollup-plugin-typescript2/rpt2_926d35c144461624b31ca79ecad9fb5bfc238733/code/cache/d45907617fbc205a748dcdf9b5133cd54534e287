{"code":"var Sprite3D = Laya.Sprite3D;\r\nvar V3 = Laya.Vector3;\r\nvar V2 = Laya.Vector2;\r\nimport { Scene3DBase } from \"../../../frame/scene3d/Scene3DBase\";\r\nimport { BuildSetting, BuildSpace } from \"./BulidSpace\";\r\nimport { Vec3Util } from \"../../../frame/util/Vec3Util\";\r\nimport { BuildDrawLines } from \"./BuildDrawLines\";\r\nimport BrowserUtil from \"../../../frame/util/BrowserUtil\";\r\nimport DateUtil from \"../../../frame/util/DateUtil\";\r\nimport Vec2Util from \"../../../frame/util/Vec2Util\";\r\nimport GameHelp from \"../../common/help/GameHelp\";\r\nimport MathUtil from \"../../../frame/util/MathUtil\";\r\nimport { TimerMgr } from \"../../common/timer/TimerMgr\";\r\nimport { BuildMesh } from \"./BuildMesh\";\r\nimport { E } from \"../../G\";\r\nimport { RaycastHelper } from \"../../../frame/help/RaycastHelp\";\r\nimport { Facer } from \"./facer/Facer\";\r\nimport { EBuildDir, EBuildLayer, EHomeScene } from \"./BuildHelper\";\r\nimport { BuildBoxManager } from \"./BuildBox\";\r\nimport NumberUtil from \"../../../frame/util/NumberUtil\";\r\nimport { BuildEventID } from \"./event/BuildEventID\";\r\nimport { BuildAreaManager } from \"./BuildArea\";\r\nimport { HomeClient } from \"../../network/clients/HomeClient\";\r\nimport t_house_res_help from \"../../static/json/data/cfg_t_house_res\";\r\nimport StringUtil from \"../../../frame/util/StringUtil\";\r\nimport ListUtil from \"../../../frame/util/ListUtil\";\r\nimport { EBuildOption, HomeData } from \"./data/HomeData\";\r\nimport { Player } from \"../../player/Player\";\r\nimport { CameraUtil } from \"../../../frame/util/CameraUtil\";\r\nimport { EAxis, TweenEase } from \"../../common/defines/EnumDefine\";\r\nimport { EDirection, MapEditorHelper } from \"../house/help/MapEditorHelper\";\r\nimport { ResPath } from \"../../resouce/ResPath\";\r\nimport Callback from \"../../event/Callback\";\r\nimport TimeUtil from \"../../../frame/util/TimeUtil\";\r\nimport t_house_ground_help from \"../../static/json/data/cfg_t_house_ground\";\r\nimport t_house_sky_help from \"../../static/json/data/cfg_t_house_sky\";\r\nimport { stVec3Tools } from \"../../network/protocols/ProtoWorld\";\r\nimport { Tween3dUtil } from \"../../../frame/util/Tween3dUtil\";\r\nimport TweenUtil from \"../../../frame/util/TweenUtil\";\r\nexport class BuildScene3D extends Scene3DBase {\r\n    constructor() {\r\n        super(...arguments);\r\n        this._canCreate = false;\r\n        this._floorAnimMoveSpeed = 0.1;\r\n        this._minCameraToGroundDis = 0.1;\r\n        this._maxCameraToGroundDis = 500;\r\n        this._originCameraToGroundDis = 5;\r\n        this._curCameraToGroundDis = 0;\r\n        this._lastCameraToGroundDis = 0;\r\n        this._isFocusing = false;\r\n        this._cameraDirNormal = new V3(0, 0, -1);\r\n        this._originPos = Vec3Util.ZERO;\r\n        this.xNum = 100;\r\n        this.yNum = 100;\r\n        this.zNum = 100;\r\n        this.minStep = 100;\r\n        this.curStep = 0;\r\n        this.minMoveStep = 1;\r\n        this._defaultLayer = EBuildLayer.Layer_10;\r\n        this._cameraRotateSpeed = 0.15;\r\n        this._cameraMoveSpeed = 0.3;\r\n        this._wheelSpeed = 0.01;\r\n        this._lastClickTime = 0;\r\n        this._curClickTime = 0;\r\n        this._clickDuration = 0;\r\n        this._minDoubleClickTime = 300;\r\n        this._isMoving = false;\r\n        this._isLeftMouseDown = false;\r\n        this._isRightMouseDown = false;\r\n        this._minScreenMoveLimit = 3;\r\n        this._lastTwoTouchDis = 0;\r\n        this._lastTouchCount = 0;\r\n        this.isAddClickEventTimer = false;\r\n        this._isRevoke = false;\r\n        this._tmpLastResId = 0;\r\n        this._tmpCurResId = 0;\r\n        this._tmpUUID = StringUtil.Empty;\r\n    }\r\n    onEnter() { }\r\n    onExit() { }\r\n    onUpdate() { }\r\n    onLateUpdate() { }\r\n    onFixedUpdate() { }\r\n    onInit() { }\r\n    onAddLoadRes() { }\r\n    onAddListener() {\r\n        this.Event.addEventCus(BuildEventID.CreateRsp, this.onHomeCreateRsp, this);\r\n        this.Event.addEventCus(BuildEventID.DeleteRsp, this.onHomeDeleteRsp, this);\r\n        this.Event.addEventCus(BuildEventID.MoveBoxRsp, this.onHomeMoveBoxRsp, this);\r\n        this.Event.addEventCus(BuildEventID.RotateBoxRsp, this.onHomeRotateBoxRsp, this);\r\n        this.Event.addEventCus(BuildEventID.ChangeMeshRsp, this.onHomeChangeMeshRsp, this);\r\n        this.Event.addEventCus(BuildEventID.ChangeSceneRsp, this.onHomeChangeSceneRsp, this);\r\n        this.Event.addEventCus(BuildEventID.OnSelectBuildListItem, this.onSelectBuildListItem, this);\r\n    }\r\n    onInit3D() {\r\n        this.onInitBuildSpace();\r\n        this.onInitScene3DHandler();\r\n    }\r\n    onClear3D() {\r\n        this.onClearScene3DHandler();\r\n        if (this._buildBoxMgr != null) {\r\n            this._buildBoxMgr.Clear();\r\n            this._buildBoxMgr = null;\r\n        }\r\n        if (this._buildAreaMgr != null) {\r\n            this._buildAreaMgr.Clear();\r\n            this._buildAreaMgr = null;\r\n        }\r\n    }\r\n    onHomeCreateRsp(data) {\r\n        if (data.errorID == 0) {\r\n            if (this._reqCreateBuild != null) {\r\n                this._reqCreateBuild.UUID = data.BoxInfo.UuId;\r\n                this.cameraFocusBuild(this._reqCreateBuild);\r\n            }\r\n            HomeData.Ins.SetAutoSelectBuildListItem(false);\r\n            this.updateBuildList();\r\n            if (HomeData.Ins.CopyID != 0) {\r\n                HomeData.Ins.SetCopyID(0);\r\n            }\r\n            if (!this._isRevoke) {\r\n                this.recordCreateOption(this._reqCreateBuild.Center, Vec3Util.ZERO, data.BoxInfo.MeshId, data.BoxInfo.UuId);\r\n                this.recordOption();\r\n            }\r\n            else {\r\n                this._isRevoke = false;\r\n            }\r\n        }\r\n        else {\r\n        }\r\n        this._canCreate = true;\r\n        this._reqCreateBuild = null;\r\n    }\r\n    onHomeDeleteRsp(data) {\r\n        if (data.errorID == 0) {\r\n            this.destoryBuildBoxById(data.UuId);\r\n            HomeData.Ins.SetAutoSelectBuildListItem(false);\r\n            this.updateBuildList();\r\n            if (!this._isRevoke) {\r\n                this.recordOption();\r\n            }\r\n            else {\r\n                this._isRevoke = false;\r\n            }\r\n        }\r\n    }\r\n    onHomeMoveBoxRsp(data) {\r\n        if (data.errorID == 0) {\r\n            let buildBox = this._buildBoxMgr.GetBoxByUUID(data.UuId);\r\n            if (buildBox != null) {\r\n                buildBox.SetWorldPos(stVec3Tools.ThisToLayaV3(data.Min), stVec3Tools.ThisToLayaV3(data.Max));\r\n                if (!this._isRevoke) {\r\n                    this.recordOption();\r\n                }\r\n                else {\r\n                    this._isRevoke = false;\r\n                    this.reCalSelectBoxData();\r\n                }\r\n            }\r\n        }\r\n    }\r\n    onHomeRotateBoxRsp(data) {\r\n        if (data.errorID == 0) {\r\n            let buildBox = this._buildBoxMgr.GetBoxByUUID(data.UuId);\r\n            if (buildBox != null) {\r\n                buildBox.SetBuildItemEuler(stVec3Tools.ThisToLayaV3(data.Euler));\r\n            }\r\n            if (this._isRevoke) {\r\n                this._isRevoke = false;\r\n            }\r\n        }\r\n    }\r\n    onHomeChangeMeshRsp(data) {\r\n        if (data.errorID == 0) {\r\n            if (!this._isRevoke) {\r\n                this.recordOption();\r\n            }\r\n            else {\r\n                this._isRevoke = false;\r\n            }\r\n            let cfg = t_house_res_help.Ins.GetDataById(data.MeshId);\r\n            if (cfg == null)\r\n                return;\r\n            this._lastSelectBox.ChangeBuildItem(cfg);\r\n        }\r\n    }\r\n    onHomeChangeSceneRsp(data) {\r\n        if (data.errorID == 0) {\r\n            if (data.SceneType == EHomeScene.Sky) {\r\n                this.changeSkyBoxMat(data.ResId);\r\n            }\r\n            else if (data.SceneType == EHomeScene.Ground) {\r\n                this.changeFloorMat(data.ResId);\r\n            }\r\n            if (this._isRevoke) {\r\n                this._isRevoke = false;\r\n            }\r\n        }\r\n    }\r\n    onSelectBuildListItem(data) {\r\n        if (data.meshId != 0) {\r\n            this._curBuildListItem = HomeData.Ins.BuildList.find(i => i.MeshId == data.meshId);\r\n            if (HomeData.Ins.IsBuildMode) {\r\n            }\r\n            else if (HomeData.Ins.IsEditMode) {\r\n                if (this._lastSelectBox != null && this._lastSelectBox.Layer == HomeData.Ins.CurLayer) {\r\n                    let info = Player.Ins.Home.GetBuildBoxInfoByUUID(data.UuId);\r\n                    if (info != null) {\r\n                        this.recordChangeOption(info.MeshId, data.meshId, this._lastSelectBox.UUID);\r\n                    }\r\n                    HomeClient.Ins.OnHomeChangeMeshReq(this._lastSelectBox.UUID, data.meshId);\r\n                }\r\n            }\r\n        }\r\n    }\r\n    OnChangeMode() {\r\n        if (HomeData.Ins.IsBuildMode) {\r\n            if (this._buildBoxMgr) {\r\n                this._buildBoxMgr.UnSelectAllBox();\r\n                this._buildBoxMgr.ShowAllObject(false);\r\n                this._buildBoxMgr.ShowCurLayerFacer(HomeData.Ins.CurLayer);\r\n                this.SetSelectBox(null);\r\n            }\r\n        }\r\n        else if (HomeData.Ins.IsEditMode) {\r\n            if (this._buildBoxMgr) {\r\n                this._buildBoxMgr.HideAllFacer();\r\n                this._buildBoxMgr.ShowAllObject(true);\r\n            }\r\n        }\r\n    }\r\n    onInitScene3DHandler() {\r\n        this.onInitCamera();\r\n        this.onInitDirLight();\r\n        this.onInitBuildDrawLines();\r\n        this.onInitBuildBase();\r\n        this.onInitFloor();\r\n        this.onInitSkyBox();\r\n    }\r\n    onClearScene3DHandler() {\r\n        this.onClearCamera();\r\n        this.onClearDirLight();\r\n        this.onClearBuildDrawLines();\r\n        this.clearFloor();\r\n    }\r\n    onInitSkyBox() {\r\n        this.changeSkyBoxMat(Player.Ins.Home.SkyResId);\r\n    }\r\n    changeSkyBoxMat(resId) {\r\n        if (this._camera == null)\r\n            return;\r\n        let config = t_house_sky_help.Ins.GetDataById(resId);\r\n        if (config == null)\r\n            return;\r\n        let path = t_house_sky_help.Ins.GetFullSkyMatPath(config.f_path);\r\n        Laya.Material.load(path, Laya.Handler.create(this, (mat) => {\r\n            if (this._camera == null) {\r\n                return;\r\n            }\r\n            let skyRender = this._camera.skyRenderer;\r\n            skyRender.mesh = Laya.SkyBox.instance;\r\n            skyRender.material = mat;\r\n        }));\r\n    }\r\n    ChangeSky(resId) {\r\n        if (!this._isRevoke) {\r\n            this.recordSkyOption(Player.Ins.Home.SkyResId, resId);\r\n            this.recordOption();\r\n        }\r\n        else {\r\n            this._isRevoke = false;\r\n        }\r\n        HomeClient.Ins.OnHomeChangeSceneReq(EHomeScene.Sky, resId);\r\n    }\r\n    onInitFloor() {\r\n        if (this._floor == null) {\r\n            E.ResMgr.LoadU3D_LH(ResPath.U3D.Floor, Callback.Create(this, (obj) => {\r\n                if (obj == null)\r\n                    return;\r\n                this._floor = obj;\r\n                this.Scene3D.addChild(this._floor);\r\n                this._floor.transform.localPosition = new V3(0, -10, 0);\r\n                this.floorUVAnimation();\r\n                this.changeFloorMat(Player.Ins.Home.GroundResId);\r\n            }));\r\n        }\r\n    }\r\n    clearFloor() {\r\n        if (this._floor != null) {\r\n            this._floor.removeSelf();\r\n            this._floor.destroy();\r\n            this._floor = null;\r\n            Laya.timer.clearAll(this);\r\n        }\r\n    }\r\n    ChangeFloor(id) {\r\n        if (!this._isRevoke) {\r\n            this.recordGroundOption(Player.Ins.Home.GroundResId, id);\r\n            this.recordOption();\r\n        }\r\n        else {\r\n            this._isRevoke = false;\r\n        }\r\n        HomeClient.Ins.OnHomeChangeSceneReq(EHomeScene.Ground, id);\r\n    }\r\n    changeFloorMat(id) {\r\n        console.log(\"changfloormat id:\" + id);\r\n        if (this._floor == null)\r\n            return;\r\n        let config = t_house_ground_help.Ins.GetDataById(id);\r\n        if (config == null)\r\n            return;\r\n        let path = t_house_ground_help.Ins.GetFullTexure2DPath(config.f_path);\r\n        if (this._floor.meshRenderer.material instanceof Laya.PBRStandardMaterial) {\r\n            let _mat = this._floor.meshRenderer.material;\r\n            Laya.Texture2D.load(path, Laya.Handler.create(null, (tex) => {\r\n                if (_mat == null) {\r\n                    return;\r\n                }\r\n                _mat.albedoTexture = tex;\r\n            }));\r\n        }\r\n    }\r\n    floorUVAnimation() {\r\n        if (this._floor == null)\r\n            return;\r\n        if (this._floor.meshRenderer.material instanceof Laya.PBRStandardMaterial) {\r\n            let _mat = this._floor.meshRenderer.material;\r\n            this.doFloorUVAnimation(_mat);\r\n        }\r\n    }\r\n    doFloorUVAnimation(mat) {\r\n        Laya.timer.frameLoop(1, this, this.changFloorMatTilingOffsetZ, [mat]);\r\n    }\r\n    changFloorMatTilingOffsetZ(mat) {\r\n        mat.tilingOffset.z += this._floorAnimMoveSpeed * TimeUtil.DeltaTimeS;\r\n        if (mat.tilingOffset.z > 1024) {\r\n            mat.tilingOffset.z -= 1024;\r\n        }\r\n    }\r\n    onInitBuildBase() {\r\n        this._buildBoxMgr = new BuildBoxManager();\r\n        this._buildAreaMgr = new BuildAreaManager();\r\n        this.onInitBuildArea();\r\n        HomeData.Ins.SetAutoSelectBuildListItem(true);\r\n        this.updateBuildList();\r\n        {\r\n            let list = Player.Ins.Home.GetBuildBoxList();\r\n            if (!ListUtil.IsNullOrEmpty(list)) {\r\n                list.forEach(info => {\r\n                    let maxPos = stVec3Tools.ThisToLayaV3(info.Max);\r\n                    let minPos = stVec3Tools.ThisToLayaV3(info.Min);\r\n                    let euler = stVec3Tools.ThisToLayaV3(info.Euler);\r\n                    let config = t_house_res_help.Ins.GetDataById(info.MeshId);\r\n                    let box = this.doCreateBuildBox(config, minPos, maxPos, euler, this.Scene3D);\r\n                    box.UUID = info.UuId;\r\n                });\r\n            }\r\n            this._canCreate = true;\r\n            if (this._buildBoxMgr.List.length > 0) {\r\n                this.cameraFocusBuild(this._buildBoxMgr.List[this._buildBoxMgr.List.length - 1]);\r\n            }\r\n        }\r\n    }\r\n    updateBuildList() {\r\n        HomeClient.Ins.OnHomeGetTotalCreateListReq();\r\n    }\r\n    onInitBuildArea() {\r\n        this._buildArea = BuildAreaManager.Create(new V3(-this.xNum / 2, 0, -this.zNum / 2), new V3(this.xNum / 2, 0, this.zNum / 2), this.Scene3D);\r\n        this._buildAreaMgr.Add(this._buildArea);\r\n        this._buildArea.Init();\r\n    }\r\n    createBuildBox(min, max, config, parent) {\r\n        if (config == null)\r\n            return;\r\n        if (!this._canCreate)\r\n            return;\r\n        let foundBox = this._buildBoxMgr.GetIntersectBuildBox(min, max);\r\n        if (foundBox != null)\r\n            return;\r\n        let createBox = this.doCreateBuildBox(config, min, max, Vec3Util.ZERO, parent);\r\n        this.sendCreateReq(createBox, min, max, Vec3Util.ZERO);\r\n    }\r\n    doCreateBuildBox(config, min, max, euler, parent) {\r\n        let box = BuildBoxManager.Create(min, max, parent);\r\n        box.Init(config, euler, []);\r\n        if (this._buildBoxMgr != null)\r\n            this._buildBoxMgr.ShowCurLayerFacer(HomeData.Ins.CurLayer);\r\n        this._buildBoxMgr.Add(box);\r\n        return box;\r\n    }\r\n    sendCreateReq(box, min, max, euler) {\r\n        this._canCreate = false;\r\n        this._reqCreateBuild = box;\r\n        HomeClient.Ins.OnHomeCreateReq(min, max, euler, this._curBuildListItem.MeshId);\r\n    }\r\n    get cameraCenterLocalEuler() { return this._cameraCenter.transform.localRotationEuler; }\r\n    set cameraCenterLocalEuler(v3) { this._cameraCenter.transform.localRotationEuler = v3; }\r\n    get cameraCenterLocalPos() { return this._cameraCenter.transform.localPosition; }\r\n    set cameraCenterLocalPos(v3) { this._cameraCenter.transform.localPosition = v3; }\r\n    onInitCamera() {\r\n        if (this._camera == null) {\r\n            this._camera = this.Scene3D.getChildByName(\"Main Camera\");\r\n        }\r\n        if (this._cameraCenter == null) {\r\n            this._cameraCenter = new Sprite3D(\"CameraCenter\");\r\n        }\r\n        this._cameraCenter.addChild(this._camera);\r\n        this.Scene3D.addChild(this._cameraCenter);\r\n        this._camera.clearColor = new Laya.Vector4();\r\n        Facer.camera = this._camera;\r\n        this.resetCamera();\r\n    }\r\n    onClearCamera() {\r\n        if (this._camera != null) {\r\n            this._camera.removeSelf();\r\n            this._camera = null;\r\n        }\r\n        if (this._cameraCenter != null) {\r\n            this._cameraCenter.removeSelf();\r\n            this._cameraCenter.destroy();\r\n            this._cameraCenter = null;\r\n        }\r\n    }\r\n    ResetCamera() { this.resetCamera(); }\r\n    resetCamera() {\r\n        this.cameraCenterLocalPos = Vec3Util.ZERO;\r\n        this.cameraCenterLocalEuler = new V3(45, 0, 0);\r\n        this.setCameraToCenterDis(this._originCameraToGroundDis);\r\n    }\r\n    cameraFocusBuild(box, tween = true) {\r\n        if (box == null)\r\n            return;\r\n        if (this._isFocusing)\r\n            return;\r\n        this._isFocusing = true;\r\n        let maxSize = 0;\r\n        let pos;\r\n        if (box.Mesh != null) {\r\n            maxSize = box.Mesh.MaxLen;\r\n            pos = box.Mesh.WorldPos;\r\n        }\r\n        else {\r\n            maxSize = box.Height;\r\n            pos = box.Center;\r\n        }\r\n        if (maxSize != 0 && pos != null) {\r\n            let dis = MathUtil.Clamp(maxSize * HomeData.Ins.CameraFocusScale, this._minCameraToGroundDis, this._maxCameraToGroundDis);\r\n            let tartPos = Vec3Util.Scale(Vec3Util.Normalize(this._cameraDirNormal), dis);\r\n            let time = MathUtil.Clamp(this.curCameraDisPercent * HomeData.Ins.CameraFocusTime, 0, HomeData.Ins.CameraFocusTime);\r\n            if (tween && time > 0) {\r\n                Tween3dUtil.To(this._cameraCenter, pos, 'position', time, TweenUtil.getEase(TweenEase.quadOut), Laya.Handler.create(this, () => {\r\n                    this.cameraCenterLocalPos = Vec3Util.Copy(pos);\r\n                }));\r\n                Tween3dUtil.To(this._camera, tartPos, 'position', time, TweenUtil.getEase(TweenEase.quadOut), Laya.Handler.create(this, () => {\r\n                    this.setCameraToCenterDis(dis);\r\n                    this._isFocusing = false;\r\n                }));\r\n            }\r\n            else {\r\n                this.cameraCenterLocalPos = Vec3Util.Copy(pos);\r\n                this.setCameraToCenterDis(dis);\r\n                this._isFocusing = false;\r\n            }\r\n        }\r\n    }\r\n    setCameraToCenterDis(dis) {\r\n        dis = MathUtil.Clamp(dis, this._minCameraToGroundDis, this._maxCameraToGroundDis);\r\n        let tartPos = Vec3Util.Scale(Vec3Util.Normalize(this._cameraDirNormal), dis);\r\n        this._camera.transform.localPosition = tartPos;\r\n        this.onCameraDisChange();\r\n    }\r\n    get cameraToOriginDis() {\r\n        if (this._camera == null)\r\n            return 0;\r\n        return Vec3Util.Distance(this._camera.transform.position, this._originPos);\r\n    }\r\n    get cameraToGroundDis(