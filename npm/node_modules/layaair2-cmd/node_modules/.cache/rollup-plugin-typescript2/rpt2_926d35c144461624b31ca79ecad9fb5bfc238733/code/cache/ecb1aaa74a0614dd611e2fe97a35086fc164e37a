ey = 1200;\r\n            qulist.push(vo);\r\n            this.datalist = qulist;\r\n            callback.run();\r\n        }\r\n    }\r\n    getInfoCallBack(data) {\r\n        this.off(BankEvent.GET_INFO, this, this.getInfoCallBack);\r\n        if (data.errorID == 0 && this.callBackGetInfo) {\r\n            this.callBackGetInfo.run();\r\n            this.callBackGetInfo = null;\r\n        }\r\n    }\r\n    testGetHis() {\r\n        if (!this.isTest) {\r\n            return;\r\n        }\r\n        this.mHisList = [];\r\n        let vo = {};\r\n        vo.createTime = 1657676879000;\r\n        vo.id = 1;\r\n        vo.make = 200;\r\n        vo.state = 1;\r\n        this.mHisList.push(vo);\r\n        vo = {};\r\n        vo.createTime = 1657676879000;\r\n        vo.id = 2;\r\n        vo.make = 1200;\r\n        vo.state = 0;\r\n        this.mHisList.push(vo);\r\n        vo = {};\r\n        vo.createTime = 1657676879000;\r\n        vo.id = 2;\r\n        vo.make = 100;\r\n        vo.state = 2;\r\n        this.mHisList.push(vo);\r\n        let d = {};\r\n        d.errorID = 0;\r\n        this.emit(BankEvent.GET_HISTORY, d);\r\n    }\r\n    convertTimeStr(v) {\r\n        let s = TimeUtil.timestamtoTime(v);\r\n        let arr = s.split(\" \");\r\n        return arr[0];\r\n    }\r\n    getLang(key) {\r\n        let bank = E.ViewMgr.Get(EViewType.Bank);\r\n        return bank.mLanguage[key];\r\n    }\r\n    getTimeString(vo) {\r\n        if (!vo) {\r\n            return \"\";\r\n        }\r\n        let str = \"\";\r\n        switch (vo.month) {\r\n            case 3:\r\n                str = this.getLang(LanguageDefine.Bank.Time3Month);\r\n                break;\r\n            case 6:\r\n                str = this.getLang(LanguageDefine.Bank.TimeHalfYear);\r\n                break;\r\n            case 12:\r\n                str = this.getLang(LanguageDefine.Bank.TimeYear);\r\n                break;\r\n            default:\r\n                str = vo.month + this.getLang(\"Mo