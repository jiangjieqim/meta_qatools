     _l.push(_vo);\r\n                    }\r\n                }\r\n                else if (type == EBankHisType.Save) {\r\n                    if (_vo.state == 0) {\r\n                        _l.push(_vo);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        return _l;\r\n    }\r\n    getListBySelf(rows) {\r\n        return rows;\r\n    }\r\n    takeOutMoney(vo) {\r\n        let _msgVo = new BankDrawMoney_req();\r\n        _msgVo.bankId = vo.id;\r\n        SocketMgr.Ins.SendMessageBin(_msgVo);\r\n    }\r\n    err(e) {\r\n        console.log(e);\r\n    }\r\n    httpSend(url, data, complete, method = \"post\") {\r\n        let laHttp = new Laya.HttpRequest();\r\n        laHttp.http.timeout = 20000;\r\n        laHttp.once(Laya.Event.COMPLETE, this, complete);\r\n        laHttp.once(Laya.Event.ERROR, this, this.err);\r\n        laHttp.send(this.rootURL + url, data, method, \"text\");\r\n    }\r\n    initUI() {\r\n        E.ViewMgr.Open(EViewType.Bank, null, []);\r\n    }\r\n    open() {\r\n        if (!this.listjson) {\r\n            this.getRate(new Laya.Handler(this, this.initUI));\r\n        }\r\n        else {\r\n            this.initUI();\r\n        }\r\n    }\r\n    serBscBank(amountDeposited, rateOfId) {\r\n        if (this.isTest) {\r\n            this.emit(BankEvent.SAVE_MOENY_SUCCEED, null);\r\n        }\r\n        else {\r\n            let obj = new BankSaveMoney_req();\r\n            obj.amountDeposited = amountDeposited;\r\n            obj.rateOfId = rateOfId;\r\n            SocketMgr.Ins.SendMessageBin(obj);\r\n        }\r\n    }\r\n    getRate(callBack) {\r\n        this.rateHander = callBack;\r\n        SocketMgr.Ins.SendMessageBin(new BankGetBecRateOf_req());\r\n        this.on(BankEvent.SEACH_RATE, this, this.onGetRate);\r\n    }\r\n    onGetRate(data) {\r\n        if (data.errorID == 0) {\r\n            this.listjson = data.lstRates;\r\n            if (this.listjson.length <= 0) {\r\n                E.ViewMgr.ShowMi