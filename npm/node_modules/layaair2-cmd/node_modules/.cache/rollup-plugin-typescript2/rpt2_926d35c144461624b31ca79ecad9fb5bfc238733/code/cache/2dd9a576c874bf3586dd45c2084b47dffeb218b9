{"code":"import { LanguageDefine } from \"../../../../systems/languages/LanguageManager\";\r\nimport ViewBase from \"../../../../../frame/view/ViewBase\";\r\nimport { ResPath } from \"../../../../resouce/ResPath\";\r\nimport { AudioHelper } from \"../../../../common/help/AudioHelper\";\r\nimport { E } from \"../../../../G\";\r\nimport { EBankModeType, ViewBank } from \"../view/ViewBank\";\r\nimport Callback from \"../../../../event/Callback\";\r\nimport { EMsgBoxType } from \"../../../../common/defines/EnumDefine\";\r\nimport { BankModel } from \"../model/BankModel\";\r\nimport { BankEvent } from \"../model/BankEvent\";\r\nexport class CtrlBank extends ViewBase {\r\n    get model() {\r\n        return BankModel.getIns();\r\n    }\r\n    onAddEventListener() {\r\n        this.addEventSys(Laya.Event.CLICK, this.onClickClose, this, this._ui.btn_close);\r\n        this._ui.callBack = new Laya.Handler(this, this.onClickHandler);\r\n        this._ui.saveHandler = new Laya.Handler(this, this.saveRequest);\r\n    }\r\n    onTakeMoneySucceed() {\r\n        E.ViewMgr.ShowMidLabel(this.Language[LanguageDefine.Bank.GetMoneySucceed]);\r\n        this.refresh();\r\n    }\r\n    get mLanguage() {\r\n        return this.Language;\r\n    }\r\n    saveRequest() {\r\n        let model = BankModel.getIns();\r\n        let index = this._ui.getSelectIndex();\r\n        let v = this._ui.getInputValue();\r\n        if (v > model.getCurMAKE()) {\r\n            E.ViewMgr.ShowMidLabel(this.Language[LanguageDefine.Bank.MoneyNotEnough]);\r\n            return;\r\n        }\r\n        else if (v == 0) {\r\n            E.ViewMgr.ShowMidLabel(this.Language[LanguageDefine.Bank.MoneyIsZero]);\r\n            return;\r\n        }\r\n        else {\r\n            E.ViewMgr.ShowMsgBox(EMsgBoxType.OkOrCancel, this.Language[LanguageDefine.Bank.Warning1], Callback.Create(this, () => {\r\n                console.log(\"存入\" + v, \"类型\" + index);\r\n                let vo = model.getRateByIndex(index);\r\n                if (vo) {\r\n                    model.serBscBank(v, vo.id);\r\n                }\r\n            }), null);\r\n        }\r\n    }\r\n    onClickHandler(index) {\r\n        AudioHelper.Click();\r\n        console.log(\"itemClick\", index);\r\n        if (index == 0) {\r\n            this._ui.selectType(EBankModeType.Deposit);\r\n        }\r\n        else if (index == 1) {\r\n            this._ui.selectType(EBankModeType.Get);\r\n        }\r\n        else {\r\n            this._ui.selectType(EBankModeType.His);\r\n        }\r\n    }\r\n    onClickClose() {\r\n        AudioHelper.Click();\r\n        if (this._ui.uiType == EBankModeType.Main) {\r\n            E.ViewMgr.Close(this.ViewType);\r\n        }\r\n        else {\r\n            this._ui.selectType(EBankModeType.Main);\r\n        }\r\n    }\r\n    onEnter() {\r\n        this.model.on(BankEvent.TAKE_MONEY_SUCCEED, this, this.onTakeMoneySucceed);\r\n        this.model.on(BankEvent.SAVE_MOENY_SUCCEED, this, this.onSaveMoneySucceed);\r\n    }\r\n    onSaveMoneySucceed() {\r\n        E.ViewMgr.ShowMidLabel(this.Language[LanguageDefine.Bank.SaveMoneySucceed]);\r\n        if (this._ui) {\r\n            this._ui.refresh();\r\n        }\r\n    }\r\n    onExit() {\r\n        this._ui.onExit();\r\n        this.model.off(BankEvent.TAKE_MONEY_SUCCEED, this, this.onTakeMoneySucceed);\r\n        this.model.off(BankEvent.SAVE_MOENY_SUCCEED, this, this.onSaveMoneySucceed);\r\n    }\r\n    onFirstInit() {\r\n        this.UI = this._ui = new ViewBank();\r\n    }\r\n    onInit() {\r\n        this._ui.init();\r\n    }\r\n    onChangeLanguage() {\r\n        this._ui.Language = this.Language;\r\n        this._ui.lbl_content.text = this.Language[LanguageDefine.Bank.Tips];\r\n        this._ui.desc1.text = this.Language[LanguageDefine.Bank.DepoitValue];\r\n        this._ui.getmoney_tips.text = this.Language[LanguageDefine.Bank.Tips2];\r\n        this._ui.getmoney_descTf.text = this.Language[LanguageDefine.Bank.Tips1];\r\n        this._ui.selectBoxCtr.pushAll(this.Language[LanguageDefine.Bank.All] + \",\" + this.Language[LanguageDefine.Bank.Save] + \",\" + this.Language[LanguageDefine.Bank.Get]);\r\n        this._ui.saveBtn.label = this.Language[LanguageDefine.Bank.Save];\r\n        this._ui.updateViewLang();\r\n    }\r\n    onAddLoadRes() {\r\n        this.addRes(ResPath.Atlas.Bank_Main, Laya.Loader.ATLAS);\r\n        this.addRes(ResPath.View.Bank, Laya.Loader.JSON);\r\n        this.addRes(ResPath.View.BankItemView, Laya.Loader.JSON);\r\n        this.addRes(ResPath.View.BankDopositItemView, Laya.Loader.JSON);\r\n        this.addRes(ResPath.View.BankSaveMoneyItem, Laya.Loader.JSON);\r\n        this.addRes(ResPath.View.BankSaveHisItem, Laya.Loader.JSON);\r\n        this.addRes(ResPath.View.BankSelectBox, Laya.Loader.JSON);\r\n        this.addRes(ResPath.View.BankSelectBoxItem, Laya.Loader.JSON);\r\n    }\r\n    refresh() {\r\n        if (this._ui) {\r\n            this._ui.refresh();\r\n        }\r\n    }\r\n}\r\n//# sourceMappingURL=CtrlBank.js.map","references":["D:/jjq/meta/trunk/gameclient/src/ui/layaMaxUI.ts","D:/jjq/meta/trunk/gameclient/src/game/systems/languages/LanguageManager.ts","D:/jjq/meta/trunk/gameclient/src/frame/view/ViewBase.ts","D:/jjq/meta/trunk/gameclient/src/game/resouce/ResPath.ts","D:/jjq/meta/trunk/gameclient/src/game/common/help/AudioHelper.ts","D:/jjq/meta/trunk/gameclient/src/game/G.ts","D:/jjq/meta/trunk/gameclient/src/game/view/handle/bank/view/ViewBank.ts","D:/jjq/meta/trunk/gameclient/src/game/event/Callback.ts","D:/jjq/meta/trunk/gameclient/src/game/common/defines/EnumDefine.ts","D:/jjq/meta/trunk/gameclient/src/game/view/handle/bank/model/BankModel.ts","D:/jjq/meta/trunk/gameclient/src/game/view/handle/bank/model/BankEvent.ts","D:/jjq/meta/trunk/gameclient/src/game/network/protocols/BankProto.ts"],"map":"{\"version\":3,\"file\":\"CtrlBank.js\",\"sourceRoot\":\"\",\"sources\":[\"../../../../../../../../../../../../../../trunk/gameclient/src/game/view/handl