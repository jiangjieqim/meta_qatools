as(partIds) {\r\n        let parts = [];\r\n        for (let i = 0; i < partIds.length; i++) {\r\n            if (partIds[i] == 0) {\r\n                continue;\r\n            }\r\n            let part = new stPartItem(partIds[i]);\r\n            ListUtil.Add(parts, part);\r\n        }\r\n        return parts;\r\n    }\r\n    LoadComponent(mSkeleton, part, path, nodeName) {\r\n        if (StringUtil.IsNullOrEmpty(path)) {\r\n            this.ClearModel(mSkeleton, nodeName);\r\n        }\r\n        else {\r\n            if (part == EPartLoadType.Type1) {\r\n                this.ChangeMaterial(mSkeleton, path, StringUtil.ParseNum(nodeName));\r\n            }\r\n            else if (part == EPartLoadType.Type2) {\r\n                this.ChangeSkinnedMesh(mSkeleton, path, nodeName);\r\n            }\r\n            else if (part == EPartLoadType.Type3) {\r\n                this.ChangeModel(mSkeleton, path, nodeName);\r\n            }\r\n            else if (part == EPartLoadType.Type4) {\r\n                this.ChangeSkinnedMeshModel(mSkeleton, path, nodeName);\r\n            }\r\n            else if (part == EPartLoadType.Type5) {\r\n                this.ReadyToCheckTextureCompile();\r\n                this.ChangeTexture(mSkeleton, path);\r\n                this.CheckTextureCompile();\r\n            }\r\n        }\r\n    }\r\n    ChangeMaterial(mSkeleton, path, index = 0) {\r\n        E.ResMgr.GetSprite3D(path, Callback.Create(this, (res) => {\r\n            if (this.bClear || mSkeleton == null) {\r\n                res.destroy();\r\n                return;\r\n            }\r\n            let mBody = UnityUtil.GetChildByName(mSkeleton, \"body\");\r\n            if (mBody) {\r\n                let resRender = UnityUtil.GetChildByName(res, \"skinnedMesh\");\r\n                let body = mBody;\r\n                let materials = body.skinnedMeshRenderer.materials;\r\n                materials[index] = resRender.skinnedMeshRenderer.material;\r\n                body.skinnedMeshRenderer.materials = materials;\r\n                this.CheckComponentFinished();\r\n            }\r\n            else {\r\n                console.error(\"mBody is null, path = \" + path);\r\n            }\r\n        }));\r\n    }\r\n    ChangeModel(mSkeleton, path, nodeName) {\r\n        E.ResMgr.GetSprite3D(path, Callback.Create(this, (res) => {\r\n            if (this.bClear || mSkeleton == null) {\r\n                res.destroy();\r\n                return;\r\n            }\r\n            let mNode = UnityUtil.GetChildByName(mSkeleton, nodeName);\r\n            if (mNode) {\r\n                if (mNode.numChildren > 0) {\r\n                    for (let i = mNode.numChildren - 1; i >= 0; i--) {\r\n                        mNode.getChildAt(i).destroy();\r\n                    }\r\n                    UnityUtil.ClearChildren(mNode);\r\n                }\r\n                let mesh = res;\r\n                mNode.addChild(mesh);\r\n                UnityUtil.ResetItem(mesh);\r\n                this.CheckComponentFinished();\r\n            }\r\n            else {\r\n                console.error(\"mNode is null, nodeName = \" + nodeName);\r\n            }\r\n        }));\r\n    }\r\n    ClearModel(mSkeleton, nodeName) {\r\n        let mNode = UnityUtil.GetChildByName(mSkeleton, nodeName);\r\n        if (mNode) {\r\n            if (mNode.numChildren > 0) {\r\n                for (let i = mNode.numChildren - 1; i >= 0; i--) {\r\n                    mNode.getChildAt(i).destroy();\r\n                }\r\n                UnityUtil.ClearChildren(mNode);\r\n            }\r\n            this.CheckComponentFinished();\r\n        }\r\n        else {\r\n            console.error(\"mNode is null, nodeName = \" + nodeName);\r\n        }\r\n    }\r\n    ChangeSkinnedMesh(mSkeleton, path, nodeName) {\r\n        E.ResMgr.GetSprite3D(path, Callback.Create(this, (res) => {\r\n            if (this.bClear || mSkeleton == null) {\r\n                res.destroy();\r\n                re